// 03_tant_que.algo
// Test de la boucle Tant Que

compteur = 5

Tant Que compteur > 0
    Afficher "Compte à rebours :", compteur
    compteur = compteur - 1
Fin Tant Que

Afficher "Décollage !"

// Test Tant Que avec une variable incrémentée
i = 0
Tant Que i < 3
    Afficher "i =", i
    i++
Fin Tant Que
