// 01_expressions.algo
// Test des opérateurs arithmétiques et de la priorité

a = 10
b = 3
c = a + b * 2
d = (a + b) * 2
e = a ** b // Puissance
f = a % b  // Modulo

Afficher "a =", a
Afficher "b =", b
Afficher "a + b * 2 =", c
Afficher "(a + b) * 2 =", d
Afficher "a ** b =", e
Afficher "a % b =", f
